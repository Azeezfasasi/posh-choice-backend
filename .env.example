# Copy to .env for local development. On Vercel/Render, set these in the
# project's Environment Variables settings instead.

# Required
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/poshchoice
JWT_SECRET=use-a-long-random-string-at-least-32-characters

# Public URLs (used in email links)
FRONTEND_URL=https://poshchoice.com.ng
BACKEND_URL=https://your-backend.vercel.app

# Cloudinary
cloud_name=
api_key=
api_secret=

# Email: Brevo first, SMTP fallback
BREVO_API_KEY=
BREVO_EMAIL_USER=
EMAIL_SENDER_NAME=Posh Choice Store
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true

# Notifications (comma-separated)
ADMIN_EMAILS=
RECEIVER_EMAIL=

# Local only (Vercel ignores it)
PORT=5000
